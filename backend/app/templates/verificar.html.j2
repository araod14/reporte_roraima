<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Verificación de reporte</title>
<style>
  body { font-family: "Helvetica Neue", Arial, sans-serif; background:#f3f4f6; color:#1a1a1a;
         margin:0; padding:16px; }
  .card { max-width:560px; margin:0 auto; background:#fff; border-radius:12px;
          box-shadow:0 2px 10px rgba(0,0,0,.08); overflow:hidden; }
  .head { background:#0b5cad; color:#fff; padding:16px 18px; }
  .head h1 { margin:0; font-size:18px; }
  .head p { margin:4px 0 0; opacity:.85; font-size:13px; }
  .body { padding:18px; }
  .meta { list-style:none; padding:0; margin:0 0 16px; }
  .meta li { display:flex; justify-content:space-between; gap:12px; padding:7px 0;
             border-bottom:1px solid #eef0f2; font-size:14px; }
  .meta .k { color:#6b7280; }
  .meta .v { font-weight:600; text-align:right; word-break:break-word; }
  .hash { font-family:"Courier New",monospace; font-size:12px; }
  .btns { display:flex; gap:10px; flex-wrap:wrap; margin:8px 0 18px; }
  .btn { flex:1; text-align:center; padding:11px; border-radius:8px; text-decoration:none;
         font-weight:700; font-size:14px; }
  .btn.primary { background:#0b5cad; color:#fff; }
  .btn.ghost { background:#eef2f7; color:#0b5cad; }
  .verify-box { border:2px dashed #c3c9d2; border-radius:10px; padding:18px; text-align:center;
                background:#fafbfc; }
  .verify-box input { display:block; margin:10px auto 0; }
  .result { margin-top:12px; font-weight:700; padding:10px; border-radius:8px; display:none; }
  .result.ok { background:#e7f6ec; color:#1f7a3f; display:block; }
  .result.bad { background:#fdecec; color:#b3261e; display:block; }
  .notfound { padding:30px; text-align:center; color:#b3261e; font-weight:700; }
</style>
</head>
<body>
<div class="card">
  <div class="head">
    <h1>Verificación de reporte</h1>
    <p>Verificación Periódica de ISH y SDC — PDVSA</p>
  </div>
  <div class="body">
  {% if reporte %}
    <ul class="meta">
      <li><span class="k">Inspección</span><span class="v hash">{{ reporte.inspeccion_id }}</span></li>
      <li><span class="k">Versión</span><span class="v">v{{ reporte.version }}</span></li>
      {% if inspeccion %}<li><span class="k">Fecha inspección</span><span class="v">{{ inspeccion.fecha }}</span></li>{% endif %}
      <li><span class="k">Generado por</span><span class="v">{{ reporte.generado_por }}</span></li>
      <li><span class="k">Generado el</span><span class="v">{{ reporte.fecha_generacion.strftime('%Y-%m-%d %H:%M UTC') }}</span></li>
      {% if inspeccion %}
      <li><span class="k">Inspeccionado por</span><span class="v">{{ inspeccion.inspeccionado_por_nombre or '—' }}</span></li>
      <li><span class="k">Verificado por</span><span class="v">{{ inspeccion.verificado_por_nombre or '—' }}</span></li>
      <li><span class="k">Aprobado por</span><span class="v">{{ inspeccion.aprobado_por_nombre or '—' }}</span></li>
      {% endif %}
      <li><span class="k">Hash contenido</span><span class="v hash">{{ reporte.content_hash }}</span></li>
      <li><span class="k">SHA-256 PDF</span><span class="v hash">{{ reporte.pdf_sha256 }}</span></li>
      <li><span class="k">SHA-256 HTML</span><span class="v hash">{{ reporte.html_sha256 }}</span></li>
    </ul>

    <div class="btns">
      <a class="btn primary" href="{{ pdf_url }}">Ver PDF oficial</a>
      <a class="btn ghost" href="{{ html_url }}">Ver versión web</a>
    </div>

    <div class="verify-box">
      <strong>¿Recibiste un PDF por WhatsApp?</strong>
      <div style="font-size:13px;color:#6b7280;margin-top:4px">
        Selecciónalo aquí para confirmar que no fue alterado.
      </div>
      <input type="file" id="pdfInput" accept="application/pdf">
      <div class="result" id="result"></div>
    </div>

    <script>
      const registered = "{{ reporte.pdf_sha256 }}";
      const input = document.getElementById('pdfInput');
      const result = document.getElementById('result');
      input.addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;
        const buf = await file.arrayBuffer();
        const digest = await crypto.subtle.digest('SHA-256', buf);
        const hex = Array.from(new Uint8Array(digest))
          .map(b => b.toString(16).padStart(2, '0')).join('');
        if (hex === registered) {
          result.className = 'result ok';
          result.textContent = '✓ Auténtico: el PDF coincide con el original registrado.';
        } else {
          result.className = 'result bad';
          result.textContent = '✗ El PDF NO coincide con el original. Puede haber sido modificado.';
        }
      });
    </script>
  {% else %}
    <div class="notfound">No se encontró un reporte para esta inspección/versión.</div>
  {% endif %}
  </div>
</div>
</body>
</html>
