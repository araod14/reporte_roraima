<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Panel visual ISH y SDC — {{ inspeccion.fecha }}</title>
<style>{{ css_content }}</style>
</head>
<body>

{% set st_label = {"ok": "OK", "malo": "MALO", "obs": "OBSERV.", "sindato": "S/D"} %}

<section class="slide overview-slide" data-idx="0">
  <div class="slide-head">
    <div>
      <div class="inst">Resumen general</div>
      <div class="sub">Verificación Periódica ISH y SDC · {{ inspeccion.fecha }}</div>
    </div>
  </div>
  <div class="overview-copy">Estado de los equipos por instalación</div>
  <div class="overview-chart">
    {% for installation in overview %}
    <div class="overview-row">
      <div class="overview-label"><b>{{ installation.instalacion }}</b><span>{{ installation.stats.total }} equipos</span></div>
      <div class="overview-bar">
        {% for segment in installation.segments if segment.count %}
        <div class="overview-segment {{ segment.status }}" style="width: {{ segment.percentage }}%">
          {% if segment.percentage >= 12 %}<span>{{ segment.count }} · {{ segment.percentage_label }}%</span>{% endif %}
        </div>
        {% endfor %}
      </div>
      <div class="overview-values">
        {% for segment in installation.segments %}<span class="{{ segment.status }}">{{ segment.label }} <b>{{ segment.count }}</b> · {{ segment.percentage_label }}%</span>{% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
  <div class="overview-legend">
    {% for status, label in [('ok', 'OK'), ('malo', 'MALO'), ('obs', 'OBSERV.'), ('sindato', 'S/D')] %}
    <span><i class="{{ status }}"></i>{{ label }}</span>
    {% endfor %}
  </div>
  <div class="slide-foot">
    <span>{{ inspeccion.fecha }} · generado por {{ generado_por }}</span>
    <span class="aviso">Vista visual — no es el reporte oficial firmado</span>
  </div>
</section>

{% for s in slides %}
<section class="slide" data-idx="{{ loop.index }}">
  <div class="slide-head">
    <div>
      <div class="inst">{{ s.instalacion }}</div>
      <div class="sub">Verificación Periódica ISH y SDC · {{ inspeccion.fecha }}</div>
    </div>
    <div class="counts">
      <span class="count ok">{{ s.stats.ok }} OK</span>
      <span class="count malo">{{ s.stats.malo }} Malo</span>
      <span class="count obs">{{ s.stats.obs }} Obs</span>
      {% if s.stats.sindato %}<span class="count sindato">{{ s.stats.sindato }} S/D</span>{% endif %}
    </div>
  </div>

  <div class="zonas">
    {% for z in s.sistemas %}
    <div class="zona">
      <div class="zona-head">{{ z.sistema }}</div>
      <div class="tiles">
        {% for e in z.elementos %}
        <div class="tile {{ e.status }}">
          <div class="nom">{{ e.nombre }}</div>

          {% if e.tipo == 'UPS' %}
            <span class="st">{{ st_label[e.status] }}</span>
            <div class="subchips">
              {% set pairs = 4 if e.ups_dobles else 2 %}
              {% for i in range(1, pairs + 1) %}
                <span class="subchip {{ 'on' if e['fuente_' ~ i] else 'off' }}">F{{ i }}</span>
                <span class="subchip {{ 'on' if e['bateria_' ~ i] else 'off' }}">B{{ i }}</span>
                <span class="subchip {{ 'on' if e['fan_' ~ i] else 'off' }}">V{{ i }}</span>
              {% endfor %}
            </div>
          {% else %}
            <span class="st">{{ st_label[e.status] }}</span>
            {% if e.tipo == 'CCC' and (e.valor_a or e.valor_b) %}
            <div class="vals"><b>A</b> {{ e.valor_a or '—' }} · <b>B</b> {{ e.valor_b or '—' }}</div>
            {% endif %}
          {% endif %}

          {% if e.comentario %}<div class="com">{{ e.comentario }}</div>{% endif %}
          {% if e.observacion_automatica %}<div class="com auto">{{ e.observacion_automatica }}</div>{% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>

  <div class="slide-foot">
    <span>{{ inspeccion.fecha }} · generado por {{ generado_por }}</span>
    <span class="aviso">Vista visual — no es el reporte oficial firmado</span>
  </div>
</section>
{% endfor %}

<div class="nav">
  <button id="prev" aria-label="Anterior">‹</button>
  <span class="pos" id="pos"></span>
  <button id="next" aria-label="Siguiente">›</button>
</div>

<script>
(function () {
  var slides = Array.prototype.slice.call(document.querySelectorAll('.slide'));
  var pos = document.getElementById('pos');
  var prev = document.getElementById('prev');
  var next = document.getElementById('next');
  var i = 0;

  function show(n) {
    i = Math.max(0, Math.min(slides.length - 1, n));
    slides.forEach(function (s, idx) { s.classList.toggle('active', idx === i); });
    pos.textContent = (i + 1) + ' / ' + slides.length + ' · ' + slides[i].querySelector('.inst').textContent;
    prev.disabled = i === 0;
    next.disabled = i === slides.length - 1;
  }
  prev.addEventListener('click', function () { show(i - 1); });
  next.addEventListener('click', function () { show(i + 1); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'ArrowLeft') show(i - 1);
    else if (e.key === 'ArrowRight') show(i + 1);
  });
  // Swipe táctil
  var x0 = null;
  document.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
  document.addEventListener('touchend', function (e) {
    if (x0 === null) return;
    var dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) show(dx < 0 ? i + 1 : i - 1);
    x0 = null;
  }, { passive: true });

  show(0);
})();
</script>

</body>
</html>
