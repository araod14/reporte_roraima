<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Verificación Periódica ISH y SDC — {{ inspeccion.fecha }}</title>
<style>{{ css_content }}</style>
</head>
<body>

<div class="doc-header">
  <div class="eyebrow">Reporte oficial · v{{ version }}</div>
  <div class="title">Verificación Periódica<br>de ISH y SDC</div>
  <div class="subtitle">PDVSA · Inspección de sistemas</div>
  <div class="meta-grid">
    <div class="meta-item meta-date"><span class="lbl">Fecha</span><span class="meta-value">{{ inspeccion.fecha }}</span></div>
    <div class="meta-item"><span class="lbl">Inspeccionado por</span><span class="meta-value">{{ inspeccion.inspeccionado_por_nombre or "—" }}</span></div>
    <div class="meta-item"><span class="lbl">Verificado por</span><span class="meta-value">{{ inspeccion.verificado_por_nombre or "—" }}</span></div>
    <div class="meta-item"><span class="lbl">Aprobado por</span><span class="meta-value">{{ inspeccion.aprobado_por_nombre or "—" }}</span></div>
  </div>
</div>

{# ---------- Resumen ejecutivo ---------- #}
<div class="resumen {{ 'ok' if n_problemas == 0 else 'alerta' }}">
  {% if n_problemas == 0 %}
    <div class="resumen-head">✓ Sin elementos con problema</div>
    <div class="resumen-sub">No hay elementos capturados en estado MALO.</div>
  {% else %}
    <div class="resumen-head">⚠ {{ n_problemas }} elemento{{ 's' if n_problemas != 1 }} requiere{{ 'n' if n_problemas != 1 }} atención</div>
    <ul class="resumen-list">
      {% for item in resumen %}
      <li>
        <span class="badge {{ 'malo' if item.estado == 'MALO' else 'obs' }}">{{ item.estado }}</span>
        <span class="rl-loc">{{ item.instalacion }} · {{ item.sistema }}</span>
        <div class="rl-name">{{ item.nombre }}</div>
        {% if item.comentario %}<div class="rl-com">{{ item.comentario }}</div>{% endif %}
      </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>

{% if inspeccion.observaciones_generales %}
<div class="obs-generales">
  <div class="lbl">Observaciones generales</div>
  <div>{{ inspeccion.observaciones_generales }}</div>
</div>
{% endif %}

{# ---------- Detalle por sistema ---------- #}
{% for g in grupos %}
<table class="card">
  <thead>
    <tr><th class="card-head">{{ g.instalacion }} · {{ g.sistema }}</th></tr>
  </thead>
  <tbody>

  {% if g.tipo == 'UPS' %}
    {% for e in g.elementos %}
    <tr><td class="ups-item">
      <div class="ups-title">
        <div class="ups-name">{{ e.nombre }}</div>
        {% if e.estado == 'MALO' %}<span class="badge malo">MALO</span>{% endif %}
      </div>
      <div class="ups-grid">
        <div class="ups-grid-head">
          <span>Módulo</span><span>Fuente</span><span>Batería</span><span>Fan</span>
        </div>
        {% set pairs = 4 if e.ups_dobles else 2 %}
        {% for i in range(1, pairs + 1) %}
        <div class="ups-module">
          <span class="module-number">{{ i }}</span>
          <span class="signal {{ 'on' if e['fuente_' ~ i] else 'off' }}">{{ '✓' if e['fuente_' ~ i] else '✕' }}</span>
          <span class="signal {{ 'on' if e['bateria_' ~ i] else 'off' }}">{{ '✓' if e['bateria_' ~ i] else '✕' }}</span>
          <span class="signal {{ 'on' if e['fan_' ~ i] else 'off' }}">{{ '✓' if e['fan_' ~ i] else '✕' }}</span>
        </div>
        {% endfor %}
      </div>
      {% if e.comentario %}<div class="com">{{ e.comentario }}</div>{% endif %}
    </td></tr>
    {% endfor %}
  {% else %}
    {% for e in g.elementos %}
    <tr><td class="row">
      <div class="row-main">
        <span class="row-name">{{ e.nombre }}</span>
        <span class="badge {{ {'OK':'ok','MALO':'malo','OBSERVACION':'obs'}.get(e.estado, 'none') }}">
          {{ e.estado or '—' }}
        </span>
      </div>
      {% if e.tipo == 'CCC' and (e.valor_a or e.valor_b) %}
      <div class="valores">
        <span><span class="lbl">A</span> {{ e.valor_a or '—' }}</span>
        <span><span class="lbl">B</span> {{ e.valor_b or '—' }}</span>
      </div>
      {% endif %}
      {% if e.comentario %}<div class="com">{{ e.comentario }}</div>{% endif %}
    </td></tr>
    {% endfor %}
  {% endif %}
  </tbody>
</table>
{% endfor %}

{# ---------- Verificación al final, siempre dentro del flujo ---------- #}
<div class="verification">
  <div class="verification-copy">
    <div class="verification-title">Verificación del reporte</div>
    <div class="verification-help">Escanea el código QR para comprobar la autenticidad de este documento.</div>
    <div class="verification-meta">
      <div><span class="lbl">Generado por</span>{{ generado_por }}</div>
      <div><span class="lbl">Versión</span>v{{ version }}</div>
    </div>
    <div class="hash"><span class="lbl">Hash de contenido</span>{{ hash_short }}</div>
  </div>
  <div class="verification-qr">
    <img src="{{ qr_uri }}" alt="QR verificación">
  </div>
</div>

</body>
</html>
