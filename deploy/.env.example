# Copia este archivo a .env y ajusta los valores.

# Dominio con HTTPS del servicio (Caddy pide el certificado para este dominio).
DOMAIN=reportes.midominio.com

# URL pública base (se usa para el QR de verificación estampado en el PDF).
# Normalmente https:// + el mismo DOMAIN.
BASE_URL=https://reportes.midominio.com

# Secreto para firmar los JWT. GENERA UNO ALEATORIO, p. ej.:
#   openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-aleatorio

# Contraseña inicial de los 6 usuarios del seed (cámbiala luego con manage_users).
SEED_PASSWORD=roraima2026

# PostgreSQL
POSTGRES_USER=roraima
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=roraima

# Biblioteca Gemini: confirmar en Google AI Studio que la clave pertenece a
# un proyecto Free Tier SIN facturación vinculada ANTES de poner true.
LIBRARY_GEMINI_FREE_TIER_CONFIRMED=false
# Clave API en ../library_secrets/gemini.key (0600), nunca aquí.
